# Copy this file to .env for local development, or set these as
# environment variables in your deployment platform (Railway, etc).
# Never commit a real .env file — it's already in .gitignore.

# ---- Required ----

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# This protects the two whole-database routes (/data/export-db,
# /data/import-db). Ordinary chat/journal/etc. routes are open by
# default unless you set SM_ACCESS_MODE=private below.
SM_SHARED_SECRET=your-generated-secret-here

# ---- Optional ----

# "private" (default if unset) — every route requires SM_SHARED_SECRET,
#   same as the original single-user design. Recommended default for
#   your own personal instance.
# "public" — only the two whole-database routes require the secret;
#   everything else (chat, journal, insights) is open to any visitor.
#   Only set this if you deliberately want a public-facing demo — see
#   the README section "Making Your Instance Public" before enabling.
SM_ACCESS_MODE=private

# If unset, the app falls back to the prompt text hardcoded in
# prompts.py's _FALLBACK_PROMPT. Set this to keep your real prompt
# out of git if you plan to make the repo public later.
SM_SYSTEM_PROMPT=

# Chat rate limit — this is YOUR call, based on your own API plan.
# Defaults: 20 requests per hour, per IP. Set SM_CHAT_RATE_LIMIT=0 to
# disable rate limiting entirely (e.g. if you're the only user, or you
# trust your own API plan's own quota to be the real limit).
SM_CHAT_RATE_LIMIT=20
SM_CHAT_RATE_WINDOW_SECONDS=3600